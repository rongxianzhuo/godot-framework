<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!--
      Tests project for godot-framework.
      Uses Godot.NET.Sdk so it picks up GodotSharp.dll transitively from the
      framework ProjectReference. xUnit + Microsoft.NET.Test.Sdk drive the
      standard dotnet test runner.
      Tests in this project are deliberately POCO-only (no Godot engine
      runtime) so they run cleanly under `dotnet test`. See tests/README.md.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Godot.NET.Sdk" Version="4.7.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\GodotFramework.csproj" />
  </ItemGroup>
</Project>
