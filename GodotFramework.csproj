<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GameFramework</RootNamespace>
    <AssemblyName>GodotFramework</AssemblyName>
    <!--
      GameFramework is structured as a git-submodule-ready Godot library.

      Two source folders are compiled by this csproj:
        src/GameFramework/   - library code (namespace GameFramework)
        samples/Demo/        - sample consumer that exercises the library

      The sample is built together with the library here so we can run the
      headless smoke test via the root project.godot (which is also at this
      level). Consumer games typically do NOT want sample code in their build,
      so the recommended integration pattern is `<Compile Include>` on the
      library folder only (see README.md §"Integration").

      EnableDefaultCompileItems=false + explicit Compile whitelist below
      is REQUIRED: without it, Microsoft.NET.Sdk's default Compile glob
      (**/*.cs) silently pulls in any .cs under tests/, tools/, or any
      future subdirectory. See README.md §"Integration" §"default Compile
      glob" for the consumer-side warning.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Godot.NET.Sdk" Version="4.7.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Whitelist: only these two folders are compiled into the framework assembly. -->
    <Compile Include="src/GameFramework/**/*.cs" />
    <Compile Include="samples/Demo/**/*.cs" />
  </ItemGroup>
</Project>
